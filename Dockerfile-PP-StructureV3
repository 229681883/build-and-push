FROM python:3.10-slim

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3-dev \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    wget \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 升级 pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# 安装 PaddlePaddle（ARM64 版本）
# 注意：ARM64 版本的 PaddlePaddle 可能需要从源码构建或使用特定渠道
RUN python3 -m pip install paddlepaddle==3.2.0 -i https://www.paddlepaddle.org.cn/packages/stable/cpu/

# 安装 安装推理包
RUN python3 -m pip install "paddleocr[all]"

# 安装 基础服务化部署
RUN paddlex --install serving

# 创建工作目录
WORKDIR /app

# 这里可以根据需要下载特定的模型
RUN paddlex --download_model PP-StructureV3 /app/models

# 暴露服务端口（默认 8080）
EXPOSE 8080

# 启动命令
CMD ["paddlex", "--serve", "--pipeline", "PP-StructureV3", "--host", "0.0.0.0", "--port", "8080"]
